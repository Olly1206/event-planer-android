<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_background"
    tools:context=".PrivateEventTypesActivity">

    <!-- Gradient header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_purple_gradient"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/textViewSelectType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Private Event Type"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btnBirthdayParty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Birthday Party"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/brand_purple_end"
                android:textColor="@color/brand_purple_primary" />

            <Button
                android:id="@+id/btnWedding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Wedding"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/brand_purple_end"
                android:textColor="@color/brand_purple_primary" />

            <Button
                android:id="@+id/btnFamilyReunion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Family Reunion"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/brand_purple_end"
                android:textColor="@color/brand_purple_primary" />

            <Button
                android:id="@+id/btnHouseParty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="House Party"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/brand_purple_end"
                android:textColor="@color/brand_purple_primary" />

            <Button
                android:id="@+id/btnGraduation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Graduation"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/brand_purple_end"
                android:textColor="@color/brand_purple_primary" />

            <Button
                android:id="@+id/btnAnniversary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Anniversary"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/brand_purple_end"
                android:textColor="@color/brand_purple_primary" />

            <Button
                android:id="@+id/btnOther"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Other"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/brand_purple_end"
                android:textColor="@color/brand_purple_primary" />

        </LinearLayout>
    </ScrollView>

    <!-- Next button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/surface_card">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_primary"
            android:text="Next"
            android:enabled="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:backgroundTint="@null" />

    </LinearLayout>

</LinearLayout>
