<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/bg_gradient_start"
                android:endColor="@color/bg_gradient_end" />
        </shape>
    </item>

    <item android:left="-120dp" android:top="-120dp">
        <shape android:shape="oval">
            <size android:width="260dp" android:height="260dp" />
            <solid android:color="#1AFFFFFF" />
        </shape>
    </item>

    <item android:right="-110dp" android:top="-90dp">
        <shape android:shape="oval">
            <size android:width="220dp" android:height="220dp" />
            <solid android:color="#1437FF8A" />
        </shape>
    </item>
</layer-list>
