<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/surface_background"
                android:centerColor="@color/bg_gradient_start"
                android:endColor="@color/bg_gradient_end" />
        </shape>
    </item>

    <item android:left="-120dp" android:top="-100dp">
        <shape android:shape="oval">
            <size android:width="260dp" android:height="260dp" />
            <solid android:color="#1437FF8A" />
        </shape>
    </item>

    <item android:right="-120dp" android:bottom="-130dp">
        <shape android:shape="oval">
            <size android:width="280dp" android:height="280dp" />
            <solid android:color="#18FFFFFF" />
        </shape>
    </item>
</layer-list>
