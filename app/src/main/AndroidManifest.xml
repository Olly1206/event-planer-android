<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SelectEventTypeActivity"
            android:exported="false"
            android:label="Select Event Type" />
        <activity
            android:name=".CompanyEventTypesActivity"
            android:exported="false"
            android:label="Company Event Types" />
        <activity
            android:name=".EventOptionsActivity"
            android:exported="false"
            android:label="Event Options" />
        <activity
            android:name=".TimeframeSelectionActivity"
            android:exported="false"
            android:label="Select Timeframe" />
        <activity
            android:name=".WeatherSurveyResultsActivity"
            android:exported="false"
            android:label="Results" />
        <activity
            android:name=".PrivateEventTypesActivity"
            android:exported="false"
            android:label="Private Event Types" />
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".auth.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".EventDetailActivity"
            android:exported="false"
            android:label="Event Details" />
        <activity
            android:name=".VenueSuggestionsActivity"
            android:exported="false"
            android:label="Venue Suggestions" />
        <activity
            android:name=".EditEventActivity"
            android:exported="false"
            android:label="Edit Event" />
        <activity
            android:name=".VendorSuggestionsActivity"
            android:exported="false"
            android:label="Vendor Suggestions" />
        <activity
            android:name=".JoinEventActivity"
            android:exported="true"
            android:label="Join Event">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eventplanner" android:host="join" />
            </intent-filter>
        </activity>
    </application>

</manifest>